{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zapp/ai/parameter_schema_v1",
  "title": "Zapp AI Parameter Schema v1",
  "type": "object",
  "required": [
    "schema_version",
    "request",
    "conversation",
    "profile",
    "spending",
    "subscriptions",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "zapp_prompt_v1"
    },
    "request": {
      "type": "object",
      "required": [
        "intent",
        "response_style"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "ask",
            "edit",
            "recommend",
            "summarize"
          ]
        },
        "response_style": {
          "type": "string",
          "enum": [
            "direct_answer",
            "transformation",
            "ranked_recommendations",
            "summary"
          ]
        }
      },
      "additionalProperties": false
    },
    "conversation": {
      "type": "object",
      "required": [
        "conversation_id",
        "context_type",
        "user_message"
      ],
      "properties": {
        "conversation_id": {
          "type": "integer"
        },
        "context_type": {
          "type": "string",
          "enum": [
            "general",
            "subscription",
            "product",
            "budgeting"
          ]
        },
        "user_message": {
          "type": "string",
          "minLength": 1
        },
        "linked_context": {
          "type": "object"
        },
        "memory": {
          "type": "object",
          "properties": {
            "summary_text": {
              "type": "string"
            },
            "session_state": {
              "type": "object"
            },
            "recent_messages": {
              "type": "array"
            },
            "recalled_memories": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "memory_kind",
                  "summary_text",
                  "tags",
                  "importance",
                  "updated_at"
                ],
                "properties": {
                  "memory_kind": {
                    "type": "string"
                  },
                  "summary_text": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "importance": {
                    "type": "integer"
                  },
                  "updated_at": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "properties": {
        "monthly_income": {
          "type": [
            "number",
            "null"
          ]
        },
        "monthly_fixed_expenses": {
          "type": [
            "number",
            "null"
          ]
        },
        "financial_goal": {
          "type": [
            "string",
            "null"
          ]
        },
        "risk_tolerance": {
          "type": [
            "string",
            "null"
          ]
        },
        "budget_style": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "spending": {
      "type": "object",
      "required": [
        "summary",
        "category_spend_30d",
        "recent_transactions"
      ],
      "properties": {
        "summary": {
          "type": "object",
          "required": [
            "recent_spend_total",
            "spend_last_30_days",
            "spend_transaction_count_last_30_days",
            "spend_month_to_date",
            "spend_transaction_count_month_to_date",
            "requested_spend_window_days",
            "spend_in_requested_window",
            "spend_transaction_count_in_requested_window",
            "active_subscription_monthly_commitment"
          ],
          "properties": {
            "recent_spend_total": {
              "type": "number"
            },
            "spend_last_30_days": {
              "type": "number"
            },
            "spend_transaction_count_last_30_days": {
              "type": "integer"
            },
            "spend_month_to_date": {
              "type": "number"
            },
            "spend_transaction_count_month_to_date": {
              "type": "integer"
            },
            "requested_spend_window_days": {
              "type": [
                "integer",
                "null"
              ]
            },
            "spend_in_requested_window": {
              "type": [
                "number",
                "null"
              ]
            },
            "spend_transaction_count_in_requested_window": {
              "type": [
                "integer",
                "null"
              ]
            },
            "active_subscription_monthly_commitment": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "category_spend_30d": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "amount"
            ],
            "properties": {
              "category": {
                "type": "string"
              },
              "amount": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "recent_transactions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "merchant",
              "amount",
              "currency",
              "direction",
              "occurred_at",
              "category",
              "description"
            ],
            "properties": {
              "merchant": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "amount": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              },
              "direction": {
                "type": "string"
              },
              "occurred_at": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "billing_cycle",
          "price",
          "currency",
          "renewal_date",
          "usage_frequency"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "billing_cycle": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "renewal_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage_frequency": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "user_facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "purchase_advisor_report": {
      "type": [
        "object",
        "null"
      ]
    },
    "policy": {
      "type": "object",
      "required": [
        "must_not_fabricate_data",
        "ask_clarifying_question_when_missing_data",
        "max_follow_up_questions",
        "disclaimer_required_for_specialized_guidance",
        "answer_based_on_available_context_when_possible",
        "state_context_scope_when_data_is_partial",
        "safe_next_step_bias"
      ],
      "properties": {
        "must_not_fabricate_data": {
          "type": "boolean"
        },
        "ask_clarifying_question_when_missing_data": {
          "type": "boolean"
        },
        "max_follow_up_questions": {
          "type": "integer",
          "const": 1
        },
        "disclaimer_required_for_specialized_guidance": {
          "type": "boolean"
        },
        "answer_based_on_available_context_when_possible": {
          "type": "boolean"
        },
        "state_context_scope_when_data_is_partial": {
          "type": "boolean"
        },
        "safe_next_step_bias": {
          "type": "string",
          "enum": [
            "reversible_actions_only"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
