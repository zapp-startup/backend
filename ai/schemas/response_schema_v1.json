{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zapp/ai/response_schema_v1",
  "title": "Zapp AI Response Schema v1",
  "type": "object",
  "required": [
    "response_style",
    "message",
    "follow_up_question",
    "disclaimer",
    "safe_bounds_acknowledged"
  ],
  "properties": {
    "response_style": {
      "type": "string",
      "enum": [
        "direct_answer",
        "ranked_recommendations",
        "summary",
        "transformation"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "follow_up_question": {
      "type": [
        "string",
        "null"
      ]
    },
    "disclaimer": {
      "type": [
        "string",
        "null"
      ]
    },
    "safe_bounds_acknowledged": {
      "type": "boolean",
      "const": true
    }
  },
  "additionalProperties": false
}
