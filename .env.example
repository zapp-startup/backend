SECRET_KEY='example-security-key'
DATABASE_URL='postgresql://user:password@host:port/database'
ALLOWED_HOSTS=api.your-domain.com
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_ISS=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUD=authenticated
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional service role key (admin / future server-side operations)
# SUPABASE_SERVICE_ROLE_KEY=

# OAuth BFF: must match Supabase Auth URL allow list (redirect to this backend callback).
# In local development, keep the loopback host aligned with the frontend/API host
# so Django session cookies and the OAuth callback use the same site.
# SUPABASE_OAUTH_REDIRECT_URI=https://api.your-domain.com/api/auth/oauth/callback/

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# JWT Secret from Supabase Dashboard > Project Settings > API > JWT Secret (for HS256 fallback)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Plaid (bank connectivity)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
# Required in production for app-layer encryption of stored Plaid access tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAID_TOKEN_ENCRYPTION_KEY=
# Optional rotation list. First key is the active write key; remaining keys are accepted for decrypt.
# PLAID_TOKEN_ENCRYPTION_KEYS=current_key,previous_key
PLAID_CLIENT_NAME=Zapp
# Required in production: Fernet key for app-layer encryption of sensitive business/profile fields.
APP_DATA_ENCRYPTION_KEY=
# Optional rotation list. First key is the active write key; remaining keys are accepted for decrypt.
# APP_DATA_ENCRYPTION_KEYS=current_key,previous_key

# Privacy / consent (must match hosted policy)
PRIVACY_POLICY_URL=https://your-domain.com/privacy
PRIVACY_POLICY_VERSION=1.0.0
PRIVACY_POLICY_EFFECTIVE_DATE=2026-01-01

# Banking policy (production: zapp.settings.production sets both True)
# Local dev (zapp.settings.development): defaults are relaxed (False) unless you set these.
# For strict Plaid/MFA testing locally, set:
#   BANKING_REQUIRE_MFA=true
#   BANKING_REQUIRE_FINANCIAL_CONSENT=true
BANKING_REQUIRE_MFA=true
BANKING_REQUIRE_FINANCIAL_CONSENT=true
# Session-backed step-up freshness for sensitive banking (ignored for legacy JWT clients)
BANKING_STEP_UP_REQUIRED=true
BANKING_STEP_UP_FRESHNESS_SECONDS=900

# Django session max age in seconds (default 14 days in settings)
# SESSION_COOKIE_AGE=1209600

# Throttling (optional overrides; defaults in zapp.settings.base)
# THROTTLE_BANKING_LINK_TOKEN=30/hour

# Emergency only: skip startup HTTPS validation when debugging production settings locally
# SKIP_PRODUCTION_SECURITY_VALIDATION=0
