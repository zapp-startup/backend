SECRET_KEY='example-security-key'
DATABASE_URL='postgresql://user:password@host:port/database'
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_ISS=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUD=authenticated
SUPABASE_ANON_KEY=your-supabase-anon-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# JWT Secret from Supabase Dashboard > Project Settings > API > JWT Secret (for HS256 fallback)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Plaid (bank connectivity)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
PLAID_CLIENT_NAME=Zapp
# Optional: Fernet key for app-layer encryption of Plaid access tokens at rest (generate with Fernet.generate_key())
PLAID_TOKEN_ENCRYPTION_KEY=

# Spotify (music streaming integration — OAuth + Web API; client secret backend-only)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match an app Redirect URI in Spotify Developer Dashboard (use 127.0.0.1 for local dev, not localhost)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/spotify/callback/
# Browser redirect after OAuth succeeds (your frontend URL)
SPOTIFY_OAUTH_SUCCESS_REDIRECT_URL=http://127.0.0.1:3000/settings/integrations
# Optional Fernet key for Spotify tokens; falls back to PLAID_TOKEN_ENCRYPTION_KEY
SPOTIFY_TOKEN_ENCRYPTION_KEY=
# Estimated monthly price when auto-creating a Subscription row (USD)
SPOTIFY_DEFAULT_MONTHLY_PRICE_USD=10.99
# If true, create a Spotify Subscription row when none exists so rollups have a target
SPOTIFY_AUTO_CREATE_SUBSCRIPTION=true
# Run full sync in OAuth callback (sets last_synced_at); set false if redirect is too slow
SPOTIFY_SYNC_ON_CONNECT=true

# Privacy / consent (must match hosted policy)
PRIVACY_POLICY_URL=https://your-domain.com/privacy
PRIVACY_POLICY_VERSION=1.0.0
PRIVACY_POLICY_EFFECTIVE_DATE=2026-01-01

# Banking policy (production: zapp.settings.production sets both True)
# Local dev (zapp.settings.development): defaults are relaxed (False) unless you set these.
# For strict Plaid/MFA testing locally, set:
#   BANKING_REQUIRE_MFA=true
#   BANKING_REQUIRE_FINANCIAL_CONSENT=true
BANKING_REQUIRE_MFA=true
BANKING_REQUIRE_FINANCIAL_CONSENT=true

# Throttling (optional overrides; defaults in zapp.settings.base)
# THROTTLE_BANKING_LINK_TOKEN=30/hour

# Emergency only: skip startup HTTPS validation when debugging production settings locally
# SKIP_PRODUCTION_SECURITY_VALIDATION=0
